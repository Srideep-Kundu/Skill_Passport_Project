# Disposable offline-demo configuration. Copy to .env only for a demo database.
APP_ENV=demo
DEMO_RESET_ENABLED=true
POSTGRES_DB=skill_passport_demo
POSTGRES_USER=skill_passport
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://skill_passport:change-me-local-only@postgres:5432/skill_passport_demo
REDIS_URL=redis://redis:6379/0
JWT_SECRET=demo-only-not-for-production-replace-before-sharing
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
EMBEDDING_PROVIDER=deterministic_test
EMBEDDING_MODEL=demo-deterministic-v1
EMBEDDING_DIMENSION=768
SEMANTIC_MATCHING_ENABLED=true
EXTRACTION_PROVIDER=local
PROVIDER_SUBMISSION_ENABLED=false
APPLICATION_EXECUTION_MODE=assisted
GOOGLE_CLIENT_ID=903988718766-fc67mr3p1t1c5hg46q50se9s06l6hisb.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=903988718766-fc67mr3p1t1c5hg46q50se9s06l6hisb.apps.googleusercontent.com
