APP_ENV=development
LOG_LEVEL=INFO

# Local Docker Compose defaults. Do not use these values in production.
POSTGRES_DB=skill_passport
POSTGRES_USER=skill_passport
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://skill_passport:change-me-local-only@postgres:5432/skill_passport
REDIS_URL=redis://redis:6379/0

# Generate a strong, unique value for every non-development environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins; never use a wildcard in production.
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Optional provider integrations. Leave blank locally unless testing them.
GEMINI_API_KEY=
GITHUB_TOKEN=
EXTRACTION_PROVIDER=local
EXTRACTION_SYNC_FALLBACK=false
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_BASE_SECONDS=15
EXTRACTION_RETRY_MAX_SECONDS=300
EXTRACTION_CLAIM_TIMEOUT_SECONDS=300

# Real semantic matching is opt-in. The current pgvector schema stores 768-dimensional vectors.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
SEMANTIC_MATCHING_ENABLED=false
SEMANTIC_SIMILARITY_THRESHOLD=0.75

# Fixed-window Redis limits. Production requires Redis when rate limiting is enabled.
RATE_LIMITING_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_MINUTE=5
EXTRACTION_RATE_LIMIT_PER_MINUTE=10
VERIFICATION_RATE_LIMIT_PER_MINUTE=10
