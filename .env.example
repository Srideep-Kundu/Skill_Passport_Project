# Development-only configuration. Copy this file to .env before running Docker Compose.
# The values below are intentionally non-secret local defaults; never reuse them in production.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL is initialized with these values on first creation of the local
# postgres-data volume. DATABASE_URL uses the Compose service hostname.
POSTGRES_DB=skill_passport
POSTGRES_USER=skill_passport
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://skill_passport:change-me-local-only@postgres:5432/skill_passport
REDIS_URL=redis://redis:6379/0

# JWT_SECRET is the preferred application's JWT secret variable. JWT_SECRET_KEY is
# supported for compatibility with earlier deployment configuration.
# Generate a strong, unique value for every non-development environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins; never use a wildcard in production.
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Credentials (Sign in with Google)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional provider integrations. Leave blank locally unless testing them.
GEMINI_API_KEY=
GITHUB_TOKEN=
EXTRACTION_PROVIDER=local
EXTRACTION_SYNC_FALLBACK=false
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_BASE_SECONDS=15
EXTRACTION_RETRY_MAX_SECONDS=300
EXTRACTION_CLAIM_TIMEOUT_SECONDS=300
WORKER_HEARTBEAT_TTL_SECONDS=30
# This must remain false except for the explicitly designated, disposable demo DB.
DEMO_RESET_ENABLED=false

# Resume documents are stored only in this managed local directory for development.
RESUME_STORAGE_DIR=./uploads/resumes
RESUME_MAX_UPLOAD_BYTES=5242880
RESUME_MAX_EXTRACTED_CHARACTERS=100000

# Real semantic matching is opt-in. The current pgvector schema stores 768-dimensional vectors.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
SEMANTIC_MATCHING_ENABLED=false
SEMANTIC_SIMILARITY_THRESHOLD=0.75

# Fixed-window Redis limits. Production requires Redis when rate limiting is enabled.
RATE_LIMITING_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_MINUTE=5
EXTRACTION_RATE_LIMIT_PER_MINUTE=10
VERIFICATION_RATE_LIMIT_PER_MINUTE=10
EXTERNAL_JOB_SYNC_RATE_LIMIT_PER_MINUTE=5
DISCOVERY_RUN_RATE_LIMIT_PER_MINUTE=10
APPLICATION_EXECUTION_RATE_LIMIT_PER_MINUTE=10
MIN_EXTERNAL_JOB_MATCH_SCORE=0.2
# Comma-separated public Greenhouse board tokens explicitly approved for sync.
GREENHOUSE_BOARD_TOKENS=
# Comma-separated public Lever site tokens approved for recurring discovery.
LEVER_SITE_TOKENS=
# Comma-separated public Ashby job-board names approved for recurring discovery.
# These are the final path segment of https://jobs.ashbyhq.com/{JOB_BOARD_NAME}.
ASHBY_JOB_BOARD_NAMES=
DISCOVERY_MAX_ACTIVE_PER_STUDENT=10

# Optional JSON arrays of employer-scoped application credentials. Keep blank locally.
# Format: [{"scope":"employer-board-or-site","api_key":"secret-from-provider"}]
# These values are secrets and must be configured through a secret manager in production.
GREENHOUSE_APPLICATION_CREDENTIALS=
LEVER_APPLICATION_CREDENTIALS=

# Controlled official submission is staging-only and disabled by default.
PROVIDER_SUBMISSION_ENABLED=false
LEVER_SUBMISSION_ENABLED=false
APPLICATION_EXECUTION_MODE=assisted
